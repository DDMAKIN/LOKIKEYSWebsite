# Copy to .env.local for local development, or add these in your host's
# Environment Variables settings (Vercel → Project → Settings → Environment Variables).
# Never commit a real .env file.

# ---- Phone sign-in (optional). Leave empty to hide "Continue with mobile number". ----
# Browser-side Firebase web config: public identifiers, safe to expose.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side only (used by api/phone-signin.ts). These ARE secrets: set them in the
# host's dashboard, never with a VITE_ prefix, never in page code.
FIREBASE_PROJECT_ID=
WIX_API_KEY=
WIX_SITE_ID=08e3d6d9-b449-4ad0-90b6-65a57df0c64d
ALLOWED_ORIGINS=https://ditch-mess-23616146.figma.site
# PHONE_LOGIN_EMAIL_DOMAIN=phone.lokikeys.com

# Recommended for phone sign-in in production (shared attempt limits, one-time codes).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Ad measurement (optional). Loaded only after visitor consent. ----
# Google tag ID from Google Ads or GA4, e.g. AW-123456789 or G-ABC123XYZ
VITE_GOOGLE_TAG_ID=
# Meta Pixel ID (numbers only)
VITE_META_PIXEL_ID=
